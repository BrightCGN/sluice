# /etc/sluice/gateway-gemini.env — Instanz-Konfiguration für sluice-gateway@gemini
# (§7.3, Rev. 6). chmod 600, Eigentümer root. Diese Instanz hält NUR den Gemini-Key.
# SLUICE_HOST anpassen, wenn das Gateway auf einen eigenen Server umzieht.
SLUICE_HOST=192.168.87.40
SLUICE_PORT=17892
SLUICE_GEMINI_API_KEY=
# Optionales Shared Secret — muss dann auch im Kern (sluice.env) gesetzt sein:
# SLUICE_GATEWAY_TOKEN=
