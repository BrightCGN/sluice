# /etc/sluice/gateway-anthropic.env — Instanz-Konfiguration für sluice-gateway@anthropic
# (§7.3, Rev. 6). chmod 600, Eigentümer root. Diese Instanz hält NUR den Anthropic-Key.
# SLUICE_HOST anpassen, wenn das Gateway auf einen eigenen Server umzieht.
SLUICE_HOST=192.168.87.40
SLUICE_PORT=17890
SLUICE_ANTHROPIC_API_KEY=
# Optionales Shared Secret — muss dann auch im Kern (sluice.env) gesetzt sein:
# SLUICE_GATEWAY_TOKEN=
