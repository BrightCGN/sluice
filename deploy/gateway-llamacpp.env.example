# /etc/sluice/gateway-llamacpp.env — Instanz-Konfiguration für sluice-gateway@llamacpp
# (§7.3). chmod 600, Eigentümer root. Diese Instanz hält NUR den llama.cpp-Zugang.
#
# WOZU: ein Modell im eigenen Netz (llama-server) als regulärer Provider. Das ist
# kein Egress — und läuft trotzdem hier durch, damit Clients EINEN Weg zum Modell
# kennen: ein Audit, eine Fehlerbehandlung, eine Key-Isolation. Ein zweiter,
# direkter Pfad „nur für lokal" wäre später von einem echten Egress nicht mehr zu
# unterscheiden.
SLUICE_HOST=192.0.2.10
SLUICE_PORT=17894

# Adresse des llama-server, MIT /v1. Pflicht — es gibt bewusst keinen Default:
# „localhost:8080" würde auf diese Gateway-VM zeigen statt auf die
# Modell-Maschine, und der Fehler sähe wie ein Netzproblem aus.
SLUICE_LLAMACPP_BASE_URL=http://192.0.2.50:8080/v1

# Der Key, mit dem llama-server gestartet wurde:  llama-server --api-key …
# Pflicht, es sei denn der ungeschützte Betrieb wird unten ausdrücklich erklärt.
SLUICE_LLAMACPP_API_KEY=

# Ungeschützter Betrieb — NUR mit Absicht. Ein offener Inferenz-Endpunkt im LAN
# ist einer, auf dem jeder Gast Modelle laufen lässt. Stillschweigend ohne Key zu
# senden ist deshalb nicht vorgesehen; wer es so will, sagt es hier.
# SLUICE_LLAMACPP_ALLOW_NO_AUTH=1

# Internes Nachdenken wieder einschalten. Default: AUS — und das ist kein
# Geschmack. Qwen3 und Verwandte sind hybrid, ihre Denk-Tokens zaehlen gegen
# dasselbe max_tokens wie die Antwort, und llama.cpp meldet sie nicht getrennt.
# Gemessen am 05.10.2026 am selben Prompt mit 64 Tokens Budget:
#     ohne Flag:  64 Tokens, finish_reason "length", content ""
#     mit Flag:    2 Tokens, finish_reason "stop",   content "OK"
# Eine leere Antwort ist die teuerste Fehlerart: der Aufrufer sieht keinen Fehler,
# nur nichts. Wer Nachdenken braucht, hebt auch das Budget mit an.
# SLUICE_LLAMACPP_ENABLE_THINKING=1

# Optionales Shared Secret — derselbe Wert muss auch im Kern (sluice.env) stehen.
# Erzeugen:  openssl rand -hex 32
# SLUICE_GATEWAY_TOKEN=
