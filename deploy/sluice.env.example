# /etc/sluice/sluice.env — Konfiguration des Sluice-Kerns (Spec §7.3, Rev. 7).
# chmod 600, Eigentümer root — systemd liest die Datei, der Service-User braucht sie nicht.
#
# Der Kern erreicht Provider AUSSCHLIESSLICH über die eigenständigen Gateway-Services
# (Gateway-Pflicht, Rev. 7): pro genutztem Provider die URL seines Gateways (Ports ab
# 17890). Der Kern hält KEINE Provider-Keys — die liegen nur bei den Gateways
# (gateway-<provider>.env). Fehlt die URL eines angefragten Providers, ist das ein
# harter Konfigurationsfehler (fail-closed), kein direkter Provider-Aufruf.
# Zieht ein Gateway auf einen eigenen Server um, ändert sich nur seine URL.
SLUICE_GATEWAY_ANTHROPIC_URL=http://192.168.87.40:17890
SLUICE_GATEWAY_OPENAI_URL=http://192.168.87.40:17891
SLUICE_GATEWAY_GEMINI_URL=http://192.168.87.40:17892
SLUICE_GATEWAY_MISTRAL_URL=http://192.168.87.40:17893
# Optionales Shared Secret Kern ↔ Gateways (muss auf beiden Seiten identisch sein):
# SLUICE_GATEWAY_TOKEN=
