# /etc/sluice/sluice.env — Provider-API-Keys (Spec §7.3).
# chmod 600, Eigentümer root — systemd liest die Datei, der Service-User braucht sie nicht.
# Nur die Keys setzen, die Profile per Allowlist erlauben; ein fehlender Key ist ein
# harter Fehler beim Aufruf des jeweiligen Providers, kein stiller Fallback.

SLUICE_ANTHROPIC_API_KEY=
SLUICE_OPENAI_API_KEY=
SLUICE_GEMINI_API_KEY=
SLUICE_MISTRAL_API_KEY=
