# /etc/sluice/sluice.env — Konfiguration des Sluice-Kerns (Spec §7.3).
# chmod 600, Eigentümer root — systemd liest die Datei, der Service-User braucht sie nicht.

# --- Variante A: Kern dispatcht über die eigenständigen Provider-Gateways (Rev. 6) ------
# Pro Provider die URL seines Gateway-Services (Ports ab 17890); der Kern braucht dann
# KEINEN Provider-Key — die Keys liegen nur bei den Gateways (gateway-<provider>.env).
# Zieht ein Gateway auf einen eigenen Server um, ändert sich nur diese URL.
SLUICE_GATEWAY_ANTHROPIC_URL=http://192.168.87.40:17890
SLUICE_GATEWAY_OPENAI_URL=http://192.168.87.40:17891
SLUICE_GATEWAY_GEMINI_URL=http://192.168.87.40:17892
SLUICE_GATEWAY_MISTRAL_URL=http://192.168.87.40:17893
# Optionales Shared Secret Kern ↔ Gateways (muss auf beiden Seiten identisch sein):
# SLUICE_GATEWAY_TOKEN=

# --- Variante B: Kern ruft die Provider direkt (ohne Gateway-Services) ------------------
# Nur die Keys setzen, deren Provider KEINE Gateway-URL oben haben; ein fehlender Key
# ist ein harter Fehler beim Aufruf des jeweiligen Providers, kein stiller Fallback.
# SLUICE_ANTHROPIC_API_KEY=
# SLUICE_OPENAI_API_KEY=
# SLUICE_GEMINI_API_KEY=
# SLUICE_MISTRAL_API_KEY=
