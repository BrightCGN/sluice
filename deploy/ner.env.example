# /etc/sluice/ner.env — Konfiguration des NER-Dienstes (§7.5, Rev. 12).
# chmod 600, Eigentümer root. Vorlage: nach /etc/sluice/ner.env kopieren und füllen.

# 127.0.0.1, wenn der Dienst auf DEMSELBEN Host wie der Sluice-Kern läuft (bevorzugt:
# dann verlässt der Rohtext den Host nie). Läuft er auf einem eigenen Rechner — z. B. weil
# dort die GPU steckt —, muss er nach außen binden; dann §„Entfernter Betrieb" unten lesen.
SLUICE_HOST=127.0.0.1
SLUICE_PORT=17900

# --- Modellidentität ------------------------------------------------------------------
# Das Modell ist NICHT vorab festgelegt: mindestens zwei Kandidaten gegeneinander
# evaluieren (scripts/eval_ner.py), deutsche Sprachabdeckung ist zwingend. Kandidaten
# und Bewertung: docs/NER-SERVICE.md.
SLUICE_NER_MODEL=urchade/gliner_multi_pii-v1

# PFLICHT für die Anonymisierungs-Identität (§5.4): ohne festgenagelte Revision ist die
# Identität wertlos — das Repo könnte sich unter derselben Kennung ändern, und der
# Audit-Eintrag behauptete dann etwas Unbelegtes. Commit-Hash von HuggingFace eintragen.
SLUICE_NER_REVISION=

# Geladene Präzision — wird über /v1/info gemeldet und geht in die Identität ein.
# fp32 auf CPU (fp16 ist dort emuliert und langsamer), fp16/uint8 nur bei GPU/ONNX.
# Im ONNX-Betrieb MUSS der Wert zu SLUICE_NER_ONNX_FILE passen: der Dienst leitet die
# Präzision aus dem Exportnamen ab, sieht zusätzlich im Graph nach Quantisierungs-
# Operatoren und startet bei Widerspruch nicht (§5.4). Grund: die Datei entscheidet über
# das Ergebnis — dasselbe Repo lieferte über model.onnx 89 Spans und über
# model_quint8.onnx 113. Eine Identität, die fp32 behauptet und uint8 rechnet, wäre falsch.
SLUICE_NER_PRECISION=fp32

# --- Backend --------------------------------------------------------------------------
# cpu ist der Default und ohne Messung die richtige Wahl: ein Chokepoint ohne
# GPU-Abhängigkeit ist betrieblich robuster. Vor jedem Wechsel auf cuda:
#   python3 scripts/probe_ner_hardware.py --model $SLUICE_NER_MODEL
# Fehlt sm_61 in torch.cuda.get_arch_list(), gibt es keinen PyTorch-CUDA-Pfad auf der
# GTX 1080 Ti — dann SLUICE_NER_ONNX=1 mit CUDA-Provider statt SLUICE_NER_DEVICE=cuda.
SLUICE_NER_DEVICE=cpu
# ONNX Runtime ist auf dieser Hardware der schnellere Weg (2026-08-11 gemessen: 173 ms
# statt 1.243 ms bei 200 Zeichen). Die **quantisierte** Variante ist es NICHT — ohne
# VNNI-Befehle (erst ab Cascade Lake) kostet INT8 rund 18 %, statt zu sparen. Also
# model.onnx wählen, nicht model_quint8.onnx, und SLUICE_NER_PRECISION passend setzen.
# SLUICE_NER_ONNX=1
# SLUICE_NER_ONNX_FILE=onnx/model.onnx

# Grobe Vorfilterung des Dienstes. MUSS unter jedem Profil-Schwellwert liegen, sonst
# wäre die profilverankerte Schwelle wirkungslos — Sluice prüft das fail-closed und
# blockiert bei Verstoß (§5.4). Die wirksame Schwelle steht im Profil, nicht hier.
SLUICE_NER_SCORE_FLOOR=0.05

# Modell-Cache. Zeigt er nach /opt/sluice/models, kann in der Unit ProtectHome=true
# bleiben (siehe deploy/sluice-ner.service).
HF_HOME=/opt/sluice/models

# HuggingFace lädt große Dateien über eine eigene Chunk-Infrastruktur (hf_xet), die andere
# Endpunkte nutzt als der normale HTTPS-Download. Hinter einer restriktiven Firewall — und
# der NER-Host steht per Definition hinter einer — bricht das gern mitten im Transfer ab
# ("CAS Client Error: … error decoding response body"). Diese Zeile erzwingt den klassischen
# Pfad: langsamer, aber robust. Betrifft nur den Download, nie die Erkennung.
HF_HUB_DISABLE_XET=1

# Determinismus (§5.4): ein Thread fixiert die Reduktionsreihenfolge in
# Gleitkommaoperationen — genau daran kippen Grenzfälle am Schwellwert. Die Engine
# setzt das für PyTorch selbst; für ONNX/BLAS zusätzlich hier.
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1

# --- Entfernter Betrieb (NER-Dienst auf eigenem Host) ---------------------------------
# Der NER-Dienst ist die EINZIGE Komponente, die *unsanitisierten* Rohtext sieht — das ist
# sein Zweck. Dieser Hop trägt damit MEHR Personenbezug als der spätere Provider-Aufruf,
# und der geht über TLS. Liegt der Dienst auf einem anderen Host, gilt deshalb:
#
#   1. Transport verschlüsseln. Reihenfolge der Präferenz:
#        a) WireGuard zwischen Kern und NER-Host (dann bleibt die URL http://, aber im
#           Tunnel — und der Kern braucht SLUICE_NER_ALLOW_PLAINTEXT_REMOTE=1, weil Sluice
#           den Tunnel nicht sehen kann),
#        b) TLS-Terminierung davor (nginx/stunnel) und https:// als URL — dann greift die
#           Schranke gar nicht erst,
#        c) nur im vertrauenswürdigen, isolierten Segment: Klartext mit ausdrücklichem
#           Opt-in im Kern.
#   2. Shared Secret setzen (unten) — authentifiziert, ersetzt aber KEINE Verschlüsselung.
#   3. Firewall: Port 17900 nur von der Kern-IP.
#
# Sluice blockiert fail-closed, wenn die NER-URL nicht-loopback UND http:// ist, solange
# im Kern nicht SLUICE_NER_ALLOW_PLAINTEXT_REMOTE=1 gesetzt ist.

# Optionales Shared Secret — derselbe Wert muss auch im Kern (sluice.env) stehen.
# Bei entferntem Betrieb: nicht optional, sondern Pflicht.
# Erzeugen:  openssl rand -hex 32
# (Hex, damit systemd beim Parsen der EnvironmentFile nichts zitieren oder umdeuten muss.)
# Es authentifiziert nur — Verschlüsselung ersetzt es NICHT, siehe Abschnitt oben.
# Ablauf: docs/DEPLOY.md §4.3.
# SLUICE_NER_TOKEN=
