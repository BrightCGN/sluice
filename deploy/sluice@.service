# Sluice — Template-Unit für die Betriebsvariante „ein Service pro Gateway" (Spec §7.3, Rev. 5).
#
# Eine Instanz pro Provider, der Instanzname ist der Provider-Name:
#   systemctl enable --now sluice@anthropic sluice@openai sluice@gemini sluice@mistral
#
# Jede Instanz ist derselbe Sluice-Code mit vollständiger Guard-Kette
# (Gate → Strategie → Verifier → Audit) — der Lock `SLUICE_PROVIDER=%i` ist eine
# ZUSÄTZLICHE Schranke: die Instanz bedient genau einen Provider, Requests an andere
# Provider beantwortet sie mit 403 (fail-closed). Der Verifier wird dadurch nie gelockert.
#
# Port + API-Key pro Instanz liegen in /etc/sluice/gateway-<provider>.env
# (chmod 600, Eigentümer root). Empfohlene Port-Konvention auf der Sluice-VM (192.168.87.40):
#   anthropic → 8001   openai → 8002   gemini → 8003   mistral → 8004
# Vorteil gegenüber der Sammel-Instanz: jede Gateway-Instanz hält NUR ihren eigenen Key.
#
# Installation (zusätzlich zu den Schritten in docs/DEPLOY.md):
#   1. cp deploy/sluice@.service /etc/systemd/system/
#   2. je Provider /etc/sluice/gateway-<provider>.env anlegen (siehe deploy/gateway-*.env.example)
#   3. systemctl daemon-reload && systemctl enable --now sluice@anthropic ...
#   4. curl http://192.168.87.40:8001/v1/health   → {"status":"ok", ..., "provider_lock":"anthropic"}

[Unit]
Description=Sluice Gateway %i — Sanitisierungs-Boundary, auf Provider %i beschränkt (/v1)
Documentation=https://github.com/BrightCGN/sluice
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=sluice
Group=sluice
WorkingDirectory=/opt/sluice

# Profile (Spec §4) teilen sich alle Instanzen — EINE Policy, egal wie viele Prozesse.
Environment=SLUICE_PROFILES=/etc/sluice/profiles.toml
# Provider-Lock (Spec §7.3, Rev. 5): diese Instanz bedient genau diesen Provider.
Environment=SLUICE_PROVIDER=%i
# Port + der EINE API-Key dieser Instanz (SLUICE_PORT, SLUICE_<PROVIDER>_API_KEY).
EnvironmentFile=/etc/sluice/gateway-%i.env

ExecStart=/opt/sluice/.venv/bin/uvicorn sluice.server:app --host 192.168.87.40 --port ${SLUICE_PORT}
Restart=on-failure
RestartSec=2

# --- Prozess-Härtung: identisch zur Sammel-Unit (deploy/sluice.service) -----------------
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
