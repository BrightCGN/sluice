# ============================================================================
# VORLAGE, kein Ausgangsbestand. Diese Datei enthält absichtlich je EIN Muster
# pro Modus — darunter `passthrough` (fail-open) und `pii_ner` (braucht den
# NER-Dienst). Sie 1:1 nach /etc/sluice/profiles.toml zu kopieren schaltet damit
# Profile scharf, die niemand bewusst gewählt hat. Übernimm die Blöcke, die du
# brauchst, und lösche den Rest.
#
# Die Listen-Schreibweise bei `detector_profile` braucht Code ab Spec-Rev. 13.
# Reihenfolge beim Ausrollen: erst Code, dann Profile — nie umgekehrt.
# ============================================================================

# Irreversibel ist der Default (Rev. 9, safety first) — `mode` kann entfallen,
# dann gilt `strict`. Verifizierende Modi (generalizing/pseudonymizing) brauchen
# kein `allowed_modes`-Opt-in; nur fail-open-Modi (passthrough) verlangen die
# explizite Nennung in `allowed_modes` (Rev. 11, §4.1/§4.3).
[profile."temper"]
mode                = "generalizing"
egress_enabled      = true
allowed_purposes    = ["external_escalation", "promotion_upload"]
provider_allowlist  = ["anthropic", "gemini"]
detector_profile    = "infra"

# passthrough = komplett offen: kein Verifier, keine Transformation — der Payload
# läuft unverändert durch (nur Profil-Gate + Audit greifen noch). BEWUSSTE Entscheidung
# zum Beobachten des Roh-Egress; Rev. 11 verlangt dafür das explizite allowed_modes-Opt-in
# (sonst 403). Sichtbar wird der Durchlass nur mit SLUICE_AUDIT_LEVEL=full in sluice.env.
[profile."prismclaw"]
mode                = "passthrough"
egress_enabled      = true
allowed_purposes    = ["external_escalation", "promotion_upload"]
provider_allowlist  = ["anthropic", "gemini", "openai"]
detector_profile    = "infra"                          # bei passthrough wirkungslos (kein Verifier)
allowed_modes       = ["passthrough"]                  # Rev.-11-Pflicht für fail-open-Modi (§4.1/§4.3)


# Reversibel ist explizites Opt-in (§2) — nur wo die Rückübersetzung gebraucht wird.
[profile."aider-code"]
mode                = "pseudonymizing"
egress_enabled      = true
allowed_purposes    = ["code_completion"]
provider_allowlist  = ["anthropic", "gemini"]
detector_profile    = "code"
  [profile."aider-code".reversible]
  scope             = "session"
  ttl_seconds       = 3600
  storage           = "memory"


# `strict` redigiert selbst (substituiert [EMAIL]/[IP]/[NAME]) — der richtige Modus,
# wenn der Konsument rohen Text schickt (Crates Kuratierungs-Thema) und die Antwort
# nichts zurückzumappen braucht. `dictionary_terms` (Rev. 10) deckt freie Namen/Adressen
# ab, die die Regex-Detektoren nicht fangen. Kein `allowed_modes` nötig — `strict` ist
# verifizierend und per leerer Allowlist frei (Rev. 11).
[profile."crate"]
mode                = "strict"
egress_enabled      = true
allowed_purposes    = ["playlist_curation"]
provider_allowlist  = ["anthropic", "gemini"]
detector_profile    = ["media", "pii_de"]   # Vereinigungsmenge (Rev. 13, §5.1)
# ACHTUNG: Die Listen-Schreibweise braucht Sluice-Code ab Spec-Rev. 13. Auf einer
# älteren Installation landet die Liste ungeprüft im Profil und das Profil crasht
# zur Laufzeit (AttributeError statt sauberem Block). Erst Code ausrollen, dann
# Profile umstellen — nie umgekehrt.
dictionary_terms    = ["<haushaltsname>", "<strasse hausnr>"]  # echte Namens-/Adressliste auf der VM


# --- Rev. 12: zweistufige PII-Erkennung (§5.3) ----------------------------------------
# `pii_regex` = nur die Regex-Stufe: strukturierte Identifikatoren mit Prüfsummen
# (IBAN Mod-97, Steuer-ID, SVNR, KVNR, Luhn) plus E-Mail/IP/MAC/KFZ/Telefon. Dort, wo
# eine Prüfsumme greift, ist die Erkennung präzise — kein Modell nötig.
[profile."crate-regex"]
mode                = "pii_regex"
egress_enabled      = true
allowed_purposes    = ["playlist_curation"]
provider_allowlist  = ["anthropic", "gemini"]
detector_profile    = "pii_de"

# `pii_ner` = dieselbe Regex-Stufe PLUS Modellerkennung; das Ergebnis ist die
# Vereinigungsmenge. Das Modell übernimmt nur, was Regex prinzipiell nicht kann:
# Personennamen, Organisationen, Freitext-Adressen, Ortsangaben. Bei Überlappung
# gewinnt die Regex-Erkennung (sie kennt den validierten Typ).
#
# FAIL-CLOSED: ist der NER-Dienst weg oder reißt das Timeout, wird BLOCKIERT (503,
# sluice_mode_unavailable) — kein stiller Rückfall auf pii_regex.
[profile."prismclaw-ner"]
mode                = "pii_ner"
egress_enabled      = true
allowed_purposes    = ["external_escalation", "chat"]
provider_allowlist  = ["anthropic", "gemini"]
detector_profile    = "pii_de"
  [profile."prismclaw-ner".ner]
  url             = "http://127.0.0.1:17900"
  # RECALL-optimiert, NICHT F1-optimiert: Übermaskierung ist ein Kostenfaktor, ein
  # übersehener Span ein Datenleck. Wert auf einem separaten Dev-Split kalibrieren
  # (scripts/eval_ner.py), nie auf dem Testset. Fehlt er, gilt der unkalibrierte
  # Default und die Identität weist threshold_calibrated=false aus.
  threshold       = 0.30
  labels          = ["person", "organization", "address", "location"]
  # Timeout zählt als Ausfall ⇒ blockiert.
  timeout_seconds = 5.0
  # Teil der versionierten Anonymisierungs-Identität (§5.4). Weicht der Dienst davon
  # ab, blockiert Sluice fail-closed — ein stiller Modellwechsel ist ausgeschlossen.
  model_repo      = "urchade/gliner_multi_pii-v1"
  model_revision  = ""            # Commit-Hash eintragen, sonst ist die Identität wertlos
  model_precision = "fp32"
  # Zerlegung langer Texte (§5.3). Das Modell kürzt still über seinem Token-Fenster;
  # ohne Zerlegung prüft die NER-Stufe nur den Anfang und meldet trotzdem Erfolg.
  # Der Default ist konservativ — nur mit einer Messung vergrößern, nie geschätzt.
  max_chars_per_chunk = 700
  chunk_overlap_chars = 200

